<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartrecruit.system.repository.NotificationMapper">

    <resultMap id="NotificationMap" type="com.smartrecruit.system.entity.Notification">
        <id column="id" property="id"/>
        <result column="recipient_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="type" property="type"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createdAt"/>
    </resultMap>

    <select id="selectByUserId" resultMap="NotificationMap">
        SELECT id, recipient_id, title, content, type, is_read, create_time
        FROM sys_notification
        WHERE recipient_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="countUnreadByUserId" resultType="int">
        SELECT COUNT(*)
        FROM sys_notification
        WHERE recipient_id = #{userId} AND is_read = 0
    </select>

    <update id="updateReadAllByUserId">
        UPDATE sys_notification
        SET is_read = 1, read_time = NOW()
        WHERE recipient_id = #{userId} AND is_read = 0
    </update>

</mapper>
